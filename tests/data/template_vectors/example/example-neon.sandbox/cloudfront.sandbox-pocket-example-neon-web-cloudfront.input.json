  "function_codes": {},
  "deploy_hash_function_codes": {
    "Static": "function handler(event) {\n            var request = event.request;\n            var prefix = '/static/';\n            // viewer が同名 header を送ってもキャッシュキーに使わせない\n            delete request.headers['x-pocket-deploy-hash'];\n            if (request.uri.indexOf(prefix) === 0) {\n                var rest = request.uri.substring(prefix.length);\n                var slash = rest.indexOf('/');\n                if (slash > 0) {\n                    var segment = rest.substring(0, slash);\n                    if (/^[0-9a-f]{7,40}$/.test(segment)) {\n                        request.uri = prefix + rest.substring(slash + 1);\n                        // URI から外した hash をキャッシュキーに残す (CachePolicy が参照する)\n                        request.headers['x-pocket-deploy-hash'] = { value: segment };\n                    }\n                }\n            }\n            return request;\n        }"
  },
  "cache_control_function_codes": {
    "Static": "function handler(event) {\n            var response = event.response;\n            var status = response.statusCode;\n            if ((status >= 200 && status < 300) || status === 304) {\n                response.headers['cache-control'] = { value: 'public, max-age=31536000, immutable' };\n            }\n            return response;\n        }"
  },
  "deploy_hash_header": "x-pocket-deploy-hash",
  "api_host_function_code": "function handler(event) {\n            var request = event.request;\n            request.headers['x-forwarded-host'] = { value: request.headers.host.value };\n            // event.viewer.ip は CloudFront が TCP 接続から取得する viewer IP で詐称不可。\n            // viewer が同名 header を送っても上書きするため、origin は真の client IP を\n            // 信頼できる。OriginVerifyMiddleware が REMOTE_ADDR に正規化する。\n            request.headers['x-pocket-viewer-ip'] = { value: event.viewer.ip };\n            return request;\n        }",
