            ],
            "Resource": [
              {
                "Fn::Sub": "arn:aws:sqs:ap-northeast-1:${AWS::AccountId}:sandbox-pocket-example-dsql-pocket-main-worker"
              }
            ]
          }
        ]
      }
    },
    "permissions_boundary": null,
    "assume_role_policy_version": true,
    "external": true,
    "assume_role_policy": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Principal": {
            "Service": "scheduler.amazonaws.com"
          },
          "Action": "sts:AssumeRole"
        }
      ]
    },
    "resolved_inline_policies": {
      "invoke-handlers": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": [
              "sqs:SendMessage"
            ],
            "Resource": [
              "arn:aws:sqs:ap-northeast-1:123456789012:sandbox-pocket-example-dsql-pocket-main-worker"
            ]
          }
        ]
      }
    }
  },
  {
    "name": "sandbox-pocket-example-dsql-myorg-backup-role",
    "service": "backup.amazonaws.com",
    "managed_policy_arns": [
      "arn:aws:iam::aws:policy/service-role/AWSBackupServiceRolePolicyForBackup",
      "arn:aws:iam::aws:policy/service-role/AWSBackupServiceRolePolicyForRestores"
    ],
    "inline_policies": {},
    "permissions_boundary": null,
    "assume_role_policy_version": true,
    "external": true,
    "assume_role_policy": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Principal": {
            "Service": "backup.amazonaws.com"
          },
          "Action": "sts:AssumeRole"
        }
      ]
    },
    "resolved_inline_policies": {}
  }
]
