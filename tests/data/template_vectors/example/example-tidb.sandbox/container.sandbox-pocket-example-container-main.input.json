  "lambda_architecture": "x86_64",
  "allowed_sm_resources": [],
  "allowed_ssm_resources": [
    "arn:aws:ssm:${AWS::Region}:${AWS::AccountId}:parameter/sandbox-pocket-example-main-pocket/*",
    "arn:aws:ssm:${AWS::Region}:${AWS::AccountId}:parameter/sandbox-pocket-example-pocket-user/tidb_database_url"
  ],
  "require_list_secrets": false,
  "inbound_runtime_config": {}
}
