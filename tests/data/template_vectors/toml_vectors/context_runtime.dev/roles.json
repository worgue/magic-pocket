              {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::dev-rt-pocket-inbound-a-f14f8810d6-${AWS::AccountId}/metadata/*"
              }
            ]
          },
          {
            "Effect": "Allow",
            "Action": [
              "s3:GetObject",
              "s3:GetObjectVersion"
            ],
            "Resource": [
              {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::dev-rt-pocket-inbound-a-f14f8810d6-${AWS::AccountId}/raw/*"
              },
              {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::dev-rt-pocket-inbound-a-f14f8810d6-${AWS::AccountId}/imports/*"
              },
              {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::dev-rt-pocket-inbound-a-f14f8810d6-${AWS::AccountId}/metadata/*"
              }
            ]
          },
          {
            "Effect": "Allow",
            "Action": [
              "s3:PutObject"
            ],
            "Resource": [
              {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::dev-rt-pocket-inbound-a-f14f8810d6-${AWS::AccountId}/metadata/*"
              }
            ]
          }
        ]
      },
      "inbound-b": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": [
              "s3:ListBucket"
            ],
            "Resource": [
              {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::dev-rt-pocket-inbound-b-97d4923840-${AWS::AccountId}"
              }
            ]
          },
          {
            "Effect": "Deny",
            "Action": [
              "s3:DeleteObject",
              "s3:DeleteObjectVersion"
            ],
            "Resource": [
              {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::dev-rt-pocket-inbound-b-97d4923840-${AWS::AccountId}/raw/*"
              },
              {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::dev-rt-pocket-inbound-b-97d4923840-${AWS::AccountId}/metadata/*"
              }
            ]
          },
          {
            "Effect": "Allow",
            "Action": [
              "s3:GetObject",
              "s3:GetObjectVersion"
            ],
            "Resource": [
              {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::dev-rt-pocket-inbound-b-97d4923840-${AWS::AccountId}/raw/*"
              },
              {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::dev-rt-pocket-inbound-b-97d4923840-${AWS::AccountId}/imports/*"
              },
              {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::dev-rt-pocket-inbound-b-97d4923840-${AWS::AccountId}/metadata/*"
              }
            ]
          },
          {
            "Effect": "Allow",
            "Action": [
              "s3:PutObject"
            ],
            "Resource": [
              {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::dev-rt-pocket-inbound-b-97d4923840-${AWS::AccountId}/metadata/*"
              }
            ]
          }
        ]
      },
      "dev-rt-pocket-access-cloudformation": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": [
              "cloudformation:DescribeStacks"
            ],
            "Resource": [
              {
                "Fn::Sub": "arn:aws:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/dev-rt-*"
              }
            ]
          }
        ]
      }
    },
    "permissions_boundary": "arn:aws:iam::123456789012:policy/forge",
    "assume_role_policy_version": false,
    "external": false,
    "assume_role_policy": {
      "Statement": [
        {
          "Effect": "Allow",
          "Principal": {
            "Service": "lambda.amazonaws.com"
          },
          "Action": "sts:AssumeRole"
        }
