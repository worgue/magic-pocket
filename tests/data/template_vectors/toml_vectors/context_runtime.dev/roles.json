  },
  {
    "name": "dev-rt-pocket-codebuild-role",
    "service": "codebuild.amazonaws.com",
    "managed_policy_arns": [],
    "inline_policies": {
      "codebuild-policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": [
              "ecr:GetAuthorizationToken"
            ],
            "Resource": "*"
          },
          {
            "Effect": "Allow",
            "Action": [
              "ecr:BatchCheckLayerAvailability",
              "ecr:GetDownloadUrlForLayer",
              "ecr:BatchGetImage",
              "ecr:PutImage",
              "ecr:InitiateLayerUpload",
              "ecr:UploadLayerPart",
              "ecr:CompleteLayerUpload"
            ],
            "Resource": "arn:aws:ecr:us-east-1:123456789012:repository/*"
          },
          {
            "Effect": "Allow",
            "Action": [
              "s3:GetObject",
              "s3:GetObjectVersion"
            ],
            "Resource": "arn:aws:s3:::dev-rt-pocket-state/codebuild/*"
          },
          {
            "Effect": "Allow",
            "Action": [
              "logs:CreateLogGroup",
              "logs:CreateLogStream",
              "logs:PutLogEvents"
            ],
            "Resource": "arn:aws:logs:us-east-1:123456789012:log-group:/aws/codebuild/dev-rt-pocket-codebuild*"
          }
        ]
      }
    },
    "permissions_boundary": "arn:aws:iam::123456789012:policy/forge",
    "assume_role_policy_version": true,
    "external": false,
    "assume_role_policy": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
