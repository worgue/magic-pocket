[
  {
    "name": "lambda-prod-db-app-pocket",
    "service": "lambda.amazonaws.com",
    "managed_policy_arns": [
      "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole",
      "arn:aws:iam::aws:policy/service-role/AWSLambdaVPCAccessExecutionRole"
    ],
    "inline_policies": {
      "prod-db-pocket-access-secretsmanager": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": [
              "secretsmanager:GetSecretValue"
            ],
            "Resource": [
              {
                "Fn::Sub": "arn:aws:secretsmanager:ap-northeast-1:123456789012:secret:prod-db-app-pocket-AbCdEf"
              }
            ]
          }
        ]
      },
      "prod-db-pocket-access-rds-secret": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": [
              "secretsmanager:GetSecretValue"
            ],
            "Resource": [
              {
                "Fn::Sub": "arn:${AWS::Partition}:secretsmanager:ap-northeast-1:${AWS::AccountId}:secret:rds!cluster-*"
              }
            ],
            "Condition": {
              "StringEquals": {
                "aws:ResourceTag/aws:rds:primaryDBClusterArn": {
                  "Fn::Sub": "arn:${AWS::Partition}:rds:ap-northeast-1:${AWS::AccountId}:cluster:prod-db-pocket-aurora"
                }
              }
            }
          }
        ]
      },
      "prod-db-pocket-access-dsql": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": [
              "dsql:DbConnectAdmin"
            ],
            "Resource": [
              {
                "Fn::Sub": "arn:${AWS::Partition}:dsql:ap-northeast-1:${AWS::AccountId}:cluster/*"
              }
            ],
            "Condition": {
              "StringEquals": {
                "aws:ResourceTag/Name": "prod-db-pocket-dsql"
              }
            }
          }
        ]
      },
      "prod-db-pocket-access-cloudformation": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": [
              "cloudformation:DescribeStacks"
            ],
            "Resource": [
              {
                "Fn::Sub": "arn:aws:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/prod-db-*"
              }
            ]
          }
        ]
      }
    },
    "permissions_boundary": null,
    "assume_role_policy_version": false,
    "external": false,
    "assume_role_policy": {
      "Statement": [
        {
          "Effect": "Allow",
          "Principal": {
            "Service": "lambda.amazonaws.com"
          },
          "Action": "sts:AssumeRole"
        }
      ]
    },
    "resolved_inline_policies": {
      "prod-db-pocket-access-secretsmanager": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": [
              "secretsmanager:GetSecretValue"
            ],
            "Resource": [
              "arn:aws:secretsmanager:ap-northeast-1:123456789012:secret:prod-db-app-pocket-AbCdEf"
            ]
          }
        ]
      },
      "prod-db-pocket-access-rds-secret": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": [
              "secretsmanager:GetSecretValue"
            ],
            "Resource": [
              "arn:aws:secretsmanager:ap-northeast-1:123456789012:secret:rds!cluster-*"
            ],
            "Condition": {
              "StringEquals": {
                "aws:ResourceTag/aws:rds:primaryDBClusterArn": "arn:aws:rds:ap-northeast-1:123456789012:cluster:prod-db-pocket-aurora"
              }
            }
          }
        ]
      },
      "prod-db-pocket-access-dsql": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": [
              "dsql:DbConnectAdmin"
            ],
            "Resource": [
              "arn:aws:dsql:ap-northeast-1:123456789012:cluster/*"
            ],
            "Condition": {
              "StringEquals": {
                "aws:ResourceTag/Name": "prod-db-pocket-dsql"
              }
            }
          }
        ]
      },
      "prod-db-pocket-access-cloudformation": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": [
              "cloudformation:DescribeStacks"
            ],
            "Resource": [
              "arn:aws:cloudformation:ap-northeast-1:123456789012:stack/prod-db-*"
            ]
          }
        ]
      }
    }
  },
