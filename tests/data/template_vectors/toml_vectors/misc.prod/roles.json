              },
              {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::prod-misc-pocket-inbound-support-e9bd96e68e-${AWS::AccountId}/in/meta/*"
              }
            ]
          },
          {
            "Effect": "Allow",
            "Action": [
              "s3:PutObject"
            ],
            "Resource": [
              {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::prod-misc-pocket-inbound-support-e9bd96e68e-${AWS::AccountId}/in/meta/*"
              }
            ]
          }
        ]
      },
      "prod-misc-pocket-access-cloudformation": {
        "Version": "2012-10-17",
