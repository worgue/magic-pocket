              }
            ]
          },
          {
            "Effect": "Deny",
            "Action": [
              "s3:DeleteObject",
              "s3:DeleteObjectVersion"
            ],
            "Resource": [
              {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::prod-misc-pocket-inbound-support-e9bd96e68e-${AWS::AccountId}/in/raw/*"
              },
              {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::prod-misc-pocket-inbound-support-e9bd96e68e-${AWS::AccountId}/in/meta/*"
              }
            ]
          },
          {
            "Effect": "Allow",
            "Action": [
              "s3:GetObject",
              "s3:GetObjectVersion"
            ],
            "Resource": [
              {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::prod-misc-pocket-inbound-support-e9bd96e68e-${AWS::AccountId}/in/raw/*"
              },
              {
