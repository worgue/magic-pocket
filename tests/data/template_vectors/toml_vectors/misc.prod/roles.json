              "s3:GetObjectVersion"
            ],
            "Resource": "arn:aws:s3:::prod-misc-pocket-state/codebuild/*"
          },
          {
            "Effect": "Allow",
            "Action": [
              "logs:CreateLogGroup",
              "logs:CreateLogStream",
              "logs:PutLogEvents"
            ],
            "Resource": "arn:aws:logs:ap-northeast-1:123456789012:log-group:/aws/codebuild/prod-misc-pocket-codebuild*"
