{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Resources": {
    "Bucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "mail-perm-pocket-inbound-support-d2efa54d05-${AWS::AccountId}"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "Expire0",
              "Status": "Enabled",
              "Prefix": "raw/",
              "ExpirationInDays": 30,
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 30
              },
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 7
              }
            },
            {
              "Id": "Expire1",
              "Status": "Enabled",
              "Prefix": "metadata/",
              "ExpirationInDays": 30,
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 30
              },
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 7
              }
            },
            {
              "Id": "Expire2",
              "Status": "Enabled",
              "Prefix": "imports/",
              "ExpirationInDays": 30,
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 30
              },
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 7
              }
            },
            {
              "Id": "Expire3",
              "Status": "Enabled",
              "Prefix": "attachments/",
              "ExpirationInDays": 30,
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 30
              },
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 7
              }
            }
          ]
        }
      }
    },
    "BucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "Bucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ses.amazonaws.com"
              },
              "Action": "s3:PutObject",
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::${Bucket}/raw/*"
              },
              "Condition": {
                "StringEquals": {
                  "AWS:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnEquals": {
                  "AWS:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:ses:${AWS::Region}:${AWS::AccountId}:receipt-rule-set/default-rule-set:receipt-rule/mail-perm-pocket-inbound-support-d2efa54d05"
                  }
                }
              }
            },
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "Bucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${Bucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "Topic": {
      "Type": "AWS::SNS::Topic",
      "Properties": {
        "TopicName": "mail-perm-pocket-inbound-support-d2efa54d05"
      }
    },
    "TopicPolicy": {
      "Type": "AWS::SNS::TopicPolicy",
      "Properties": {
        "Topics": [
          {
            "Ref": "Topic"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ses.amazonaws.com"
              },
              "Action": "sns:Publish",
              "Resource": {
                "Ref": "Topic"
              },
              "Condition": {
                "StringEquals": {
                  "AWS:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnEquals": {
                  "AWS:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:ses:${AWS::Region}:${AWS::AccountId}:receipt-rule-set/default-rule-set:receipt-rule/mail-perm-pocket-inbound-support-d2efa54d05"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "DeliveryDLQ": {
      "Type": "AWS::SQS::Queue",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "QueueName": "mail-perm-pocket-inbound-support-d2efa54d05-delivery-dead-letter",
        "MessageRetentionPeriod": 1209600,
        "SqsManagedSseEnabled": true
      }
    },
    "QueuePolicy": {
      "Type": "AWS::SQS::QueuePolicy",
      "Properties": {
        "Queues": [
          {
            "Fn::Sub": "https://sqs.${AWS::Region}.${AWS::URLSuffix}/${AWS::AccountId}/mail-perm-pocket-app-mail"
          },
          {
            "Ref": "DeliveryDLQ"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "sns.amazonaws.com"
              },
              "Action": "sqs:SendMessage",
              "Resource": [
                {
                  "Fn::Sub": "arn:${AWS::Partition}:sqs:ap-northeast-1:${AWS::AccountId}:mail-perm-pocket-app-mail"
                },
                {
                  "Fn::GetAtt": [
                    "DeliveryDLQ",
                    "Arn"
                  ]
                }
              ],
              "Condition": {
                "ArnEquals": {
                  "aws:SourceArn": {
                    "Ref": "Topic"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "Subscription": {
      "Type": "AWS::SNS::Subscription",
      "DependsOn": "QueuePolicy",
      "Properties": {
        "TopicArn": {
          "Ref": "Topic"
        },
        "Protocol": "sqs",
        "Endpoint": {
          "Fn::Sub": "arn:${AWS::Partition}:sqs:ap-northeast-1:${AWS::AccountId}:mail-perm-pocket-app-mail"
        },
        "RawMessageDelivery": false,
        "RedrivePolicy": {
          "deadLetterTargetArn": {
            "Fn::GetAtt": [
              "DeliveryDLQ",
              "Arn"
            ]
          }
        }
      }
    },
    "ReceiptRule": {
      "Type": "AWS::SES::ReceiptRule",
      "DependsOn": [
        "BucketPolicy",
        "TopicPolicy",
        "QueuePolicy",
        "Subscription"
      ],
      "Properties": {
        "RuleSetName": "default-rule-set",
        "Rule": {
          "Name": "mail-perm-pocket-inbound-support-d2efa54d05",
          "Enabled": true,
          "TlsPolicy": "Require",
          "ScanEnabled": true,
          "Recipients": [
            "support@mail.example.com"
          ],
          "Actions": [
            {
              "S3Action": {
                "BucketName": {
                  "Ref": "Bucket"
                },
                "ObjectKeyPrefix": "raw/",
                "TopicArn": {
                  "Ref": "Topic"
                }
              }
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "RuleSet": {
      "Value": "default-rule-set"
    },
    "RuleName": {
      "Value": "mail-perm-pocket-inbound-support-d2efa54d05"
    },
    "AfterRule": {
      "Value": ""
    },
    "Bucket": {
      "Value": {
        "Ref": "Bucket"
      }
    },
    "TopicArn": {
      "Value": {
        "Ref": "Topic"
      }
    },
    "QueueUrl": {
      "Value": {
        "Fn::Sub": "https://sqs.${AWS::Region}.${AWS::URLSuffix}/${AWS::AccountId}/mail-perm-pocket-app-mail"
      }
    },
    "DeliveryDLQUrl": {
      "Value": {
        "Ref": "DeliveryDLQ"
      }
    },
    "WorkerDLQUrl": {
      "Value": {
        "Fn::Sub": "https://sqs.${AWS::Region}.${AWS::URLSuffix}/${AWS::AccountId}/mail-perm-pocket-app-mail-dead-letter"
      }
    },
    "Enabled": {
      "Value": "true"
    },
    "Handler": {
      "Value": "app.mail"
    },
    "RawPrefix": {
      "Value": "raw/"
    },
    "MetadataPrefix": {
      "Value": "metadata/"
    },
    "ImportPrefix": {
      "Value": "imports/"
    }
  }
}
