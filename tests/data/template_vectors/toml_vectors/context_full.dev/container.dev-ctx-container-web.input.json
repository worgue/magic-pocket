                  "s3:GetObject",
                  "s3:GetObjectVersion"
                ],
                "Resource": [
                  {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::dev-ctx-pocket-inbound-support-41d19ddf04-${AWS::AccountId}/raw/*"
                  },
                  {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::dev-ctx-pocket-inbound-support-41d19ddf04-${AWS::AccountId}/imports/*"
                  },
                  {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::dev-ctx-pocket-inbound-support-41d19ddf04-${AWS::AccountId}/metadata/*"
                  }
