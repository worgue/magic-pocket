  "scheduler": {
    "schedules": [
      {
        "key": "ping",
        "scheduler": "pocket.lambda_scheduler",
        "handler": "wsgi",
        "schedule_expression": "cron(0 * * * ? *)",
        "name": "dev-misc-pocket-ping",
        "yaml_key": "Ping",
        "input_json": "{\"path\": \"/ping\", \"nested\": {\"a\": [1, 2]}}",
        "is_django_management": false,
        "is_sqs": false
      },
      {
        "key": "cleanup",
        "scheduler": "pocket.django.management_lambda_scheduler",
        "handler": "management",
        "schedule_expression": "rate(1 day)",
        "name": "dev-misc-pocket-cleanup",
        "yaml_key": "Cleanup",
        "input_json": "{\"manage\": \"clearsessions --verbosity 2\"}",
        "is_django_management": true,
        "is_sqs": false
      },
      {
        "key": "enqueue",
        "scheduler": "pocket.sqs_scheduler",
        "handler": "jobs",
        "schedule_expression": "rate(5 minutes)",
        "name": "dev-misc-pocket-enqueue",
        "yaml_key": "Enqueue",
        "input_json": "{\"command\": \"sync\", \"args\": [\"a\"], \"kwargs\": {\"force\": true}}",
        "is_django_management": false,
        "is_sqs": true
      },
      {
        "key": "bare",
        "scheduler": "pocket.sqs_scheduler",
        "handler": "jobs",
        "schedule_expression": "rate(1 hour)",
        "name": "dev-misc-pocket-bare",
        "yaml_key": "Bare",
        "input_json": "{}",
        "is_django_management": false,
        "is_sqs": true
      },
      {
        "key": "nightly",
        "scheduler": "pocket.sqs_scheduler",
        "handler": "jobs",
        "schedule_expression": "cron(0 3 * * ? *)",
        "name": "dev-misc-pocket-nightly",
        "yaml_key": "Nightly",
        "input_json": "{\"command\": \"nightly\"}",
        "is_django_management": false,
        "is_sqs": true
      }
    ],
