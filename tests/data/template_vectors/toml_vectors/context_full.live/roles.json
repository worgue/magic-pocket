              }
            ]
          }
        ]
      },
      "live-ctx-pocket-access-cloudformation": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": [
              "cloudformation:DescribeStacks"
            ],
            "Resource": [
              {
                "Fn::Sub": "arn:aws:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/live-ctx-*"
              }
            ]
          }
        ]
      }
    },
