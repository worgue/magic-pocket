    ],
    "inline_policies": {
      "inbound-support": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": [
              "s3:ListBucket"
            ],
            "Resource": [
              {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::live-ctx-pocket-inbound-support-4f1ebcd01b-${AWS::AccountId}"
              }
            ]
          },
          {
            "Effect": "Deny",
            "Action": [
              "s3:DeleteObject",
              "s3:DeleteObjectVersion"
            ],
            "Resource": [
              {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::live-ctx-pocket-inbound-support-4f1ebcd01b-${AWS::AccountId}/raw/*"
              },
              {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::live-ctx-pocket-inbound-support-4f1ebcd01b-${AWS::AccountId}/metadata/*"
              }
            ]
          },
          {
            "Effect": "Allow",
            "Action": [
              "s3:GetObject",
              "s3:GetObjectVersion"
            ],
            "Resource": [
              {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::live-ctx-pocket-inbound-support-4f1ebcd01b-${AWS::AccountId}/raw/*"
              },
              {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::live-ctx-pocket-inbound-support-4f1ebcd01b-${AWS::AccountId}/imports/*"
              },
              {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::live-ctx-pocket-inbound-support-4f1ebcd01b-${AWS::AccountId}/metadata/*"
              }
            ]
          },
          {
            "Effect": "Allow",
            "Action": [
              "s3:PutObject"
            ],
            "Resource": [
              {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::live-ctx-pocket-inbound-support-4f1ebcd01b-${AWS::AccountId}/metadata/*"
              }
            ]
          }
        ]
      },
      "live-ctx-pocket-access-secretsmanager": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": [
              "secretsmanager:GetSecretValue"
            ],
            "Resource": [
              {
                "Fn::Sub": "arn:aws:secretsmanager:${AWS::Region}:${AWS::AccountId}:secret:plain-name-??????"
              },
              {
                "Fn::Sub": "arn:aws:secretsmanager:ap-northeast-1:123456789012:secret:x"
              }
            ]
          }
        ]
      },
      "live-ctx-pocket-access-ssm": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": [
              "ssm:GetParameter",
              "ssm:GetParameters",
              "ssm:GetParametersByPath"
            ],
            "Resource": [
