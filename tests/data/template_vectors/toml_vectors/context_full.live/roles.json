                "Fn::Sub": "arn:aws:ssm:${AWS::Region}:${AWS::AccountId}:parameter/live-ctx-web-pocket/*"
              },
              {
                "Fn::Sub": "arn:aws:ssm:ap-northeast-1:123456789012:parameter/p"
              },
