[
  {
    "name": "lambda-dev-testprj-main-pocket",
    "service": "lambda.amazonaws.com",
    "managed_policy_arns": [
      "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole",
      "arn:aws:iam::aws:policy/AmazonS3FullAccess",
      "arn:aws:iam::aws:policy/AmazonSQSFullAccess"
    ],
    "inline_policies": {
      "dev-testprj-pocket-access-cloudformation": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": [
              "cloudformation:DescribeStacks"
            ],
            "Resource": [
              {
                "Fn::Sub": "arn:aws:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/dev-testprj-*"
              }
            ]
          }
        ]
      }
    },
    "permissions_boundary": "arn:aws:iam::123456789012:policy/test-boundary",
    "assume_role_policy_version": false,
    "external": false,
    "assume_role_policy": {
      "Statement": [
        {
          "Effect": "Allow",
          "Principal": {
            "Service": "lambda.amazonaws.com"
          },
          "Action": "sts:AssumeRole"
        }
      ]
    },
    "resolved_inline_policies": {
      "dev-testprj-pocket-access-cloudformation": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": [
              "cloudformation:DescribeStacks"
            ],
            "Resource": [
              "arn:aws:cloudformation:ap-southeast-1:123456789012:stack/dev-testprj-*"
            ]
          }
        ]
      }
    }
  },
  {
    "name": "dev-testprj-pocket-main-scheduler",
    "service": "scheduler.amazonaws.com",
    "managed_policy_arns": [],
    "inline_policies": {
      "invoke-handlers": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": [
              "lambda:InvokeFunction"
            ],
            "Resource": [
              {
                "Fn::Sub": "arn:aws:lambda:ap-southeast-1:${AWS::AccountId}:function:dev-testprj-pocket-main-management"
              },
              {
                "Fn::Sub": "arn:aws:lambda:ap-southeast-1:${AWS::AccountId}:function:dev-testprj-pocket-main-worker"
              }
            ]
          },
          {
            "Effect": "Allow",
            "Action": [
              "sqs:SendMessage"
            ],
            "Resource": [
              {
                "Fn::Sub": "arn:aws:sqs:ap-southeast-1:${AWS::AccountId}:dev-testprj-pocket-main-sqsworker"
              }
            ]
          }
        ]
      }
    },
    "permissions_boundary": "arn:aws:iam::123456789012:policy/test-boundary",
    "assume_role_policy_version": true,
    "external": false,
    "assume_role_policy": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Principal": {
            "Service": "scheduler.amazonaws.com"
          },
          "Action": "sts:AssumeRole"
        }
      ]
    },
    "resolved_inline_policies": {
      "invoke-handlers": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": [
              "lambda:InvokeFunction"
            ],
            "Resource": [
              "arn:aws:lambda:ap-southeast-1:123456789012:function:dev-testprj-pocket-main-management",
              "arn:aws:lambda:ap-southeast-1:123456789012:function:dev-testprj-pocket-main-worker"
            ]
          },
          {
            "Effect": "Allow",
            "Action": [
              "sqs:SendMessage"
            ],
            "Resource": [
              "arn:aws:sqs:ap-southeast-1:123456789012:dev-testprj-pocket-main-sqsworker"
            ]
          }
        ]
      }
    }
  },
  {
    "name": "dev-testprj-pocket-codebuild-role",
    "service": "codebuild.amazonaws.com",
    "managed_policy_arns": [],
    "inline_policies": {
      "codebuild-policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": [
              "ecr:GetAuthorizationToken"
            ],
            "Resource": "*"
          },
          {
            "Effect": "Allow",
            "Action": [
              "ecr:BatchCheckLayerAvailability",
              "ecr:GetDownloadUrlForLayer",
              "ecr:BatchGetImage",
              "ecr:PutImage",
              "ecr:InitiateLayerUpload",
              "ecr:UploadLayerPart",
              "ecr:CompleteLayerUpload"
            ],
            "Resource": "arn:aws:ecr:ap-southeast-1:123456789012:repository/*"
          },
          {
            "Effect": "Allow",
            "Action": [
              "s3:GetObject",
              "s3:GetObjectVersion"
            ],
            "Resource": "arn:aws:s3:::dev-testprj-pocket-state/codebuild/*"
          },
          {
            "Effect": "Allow",
            "Action": [
              "logs:CreateLogGroup",
              "logs:CreateLogStream",
              "logs:PutLogEvents"
            ],
            "Resource": "arn:aws:logs:ap-southeast-1:123456789012:log-group:/aws/codebuild/dev-testprj-pocket-codebuild*"
          }
        ]
      }
    },
    "permissions_boundary": "arn:aws:iam::123456789012:policy/test-boundary",
    "assume_role_policy_version": true,
    "external": false,
    "assume_role_policy": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Principal": {
            "Service": "codebuild.amazonaws.com"
          },
          "Action": "sts:AssumeRole"
        }
      ]
    },
    "resolved_inline_policies": {
      "codebuild-policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": [
              "ecr:GetAuthorizationToken"
            ],
            "Resource": "*"
          },
          {
            "Effect": "Allow",
            "Action": [
              "ecr:BatchCheckLayerAvailability",
              "ecr:GetDownloadUrlForLayer",
              "ecr:BatchGetImage",
              "ecr:PutImage",
              "ecr:InitiateLayerUpload",
              "ecr:UploadLayerPart",
              "ecr:CompleteLayerUpload"
            ],
            "Resource": "arn:aws:ecr:ap-southeast-1:123456789012:repository/*"
          },
          {
            "Effect": "Allow",
            "Action": [
              "s3:GetObject",
              "s3:GetObjectVersion"
            ],
            "Resource": "arn:aws:s3:::dev-testprj-pocket-state/codebuild/*"
          },
          {
            "Effect": "Allow",
            "Action": [
              "logs:CreateLogGroup",
              "logs:CreateLogStream",
              "logs:PutLogEvents"
            ],
            "Resource": "arn:aws:logs:ap-southeast-1:123456789012:log-group:/aws/codebuild/dev-testprj-pocket-codebuild*"
          }
        ]
      }
    }
  }
]
