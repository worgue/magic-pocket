      "function_name": "stg-testprj-pocket-main-sqsmanagement",
      "log_group_name": "/aws/lambda/stg-testprj-pocket-main-sqsmanagement",
      "export_api_domain": null,
      "cloudformation_cert_ref_name": "SqsmanagementCertificate"
    }
