  "lambda_role": {
    "external": false,
    "cfn_properties": {
      "RoleName": "lambda-prod-testprj-main-pocket",
      "AssumeRolePolicyDocument": {
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "Service": "lambda.amazonaws.com"
            },
            "Action": "sts:AssumeRole"
          }
        ]
      },
      "ManagedPolicyArns": [
        "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
      ],
      "Policies": [
        {
          "PolicyName": "prod-testprj-pocket-access-ssm",
          "PolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Effect": "Allow",
                "Action": [
                  "ssm:GetParameter",
                  "ssm:GetParameters",
                  "ssm:GetParametersByPath"
                ],
                "Resource": [
                  {
                    "Fn::Sub": "arn:aws:ssm:${AWS::Region}:${AWS::AccountId}:parameter/prod-testprj-main-pocket/*"
                  }
                ]
              }
            ]
          }
        },
        {
          "PolicyName": "prod-testprj-pocket-access-cloudformation",
          "PolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Effect": "Allow",
                "Action": [
                  "cloudformation:DescribeStacks"
                ],
                "Resource": [
                  {
                    "Fn::Sub": "arn:aws:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/prod-testprj-*"
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "arn": {
      "Fn::GetAtt": "LambdaRole.Arn"
    }
  },
  "scheduler_role": null,
  "name": "main",
  "vpc": null,
  "secrets": {
