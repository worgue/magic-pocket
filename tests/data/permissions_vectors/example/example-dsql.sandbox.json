       \"Resource\": [\n                \"arn:aws:s3:::sandbox-pocket-example-dsql-pock-df065f0823-123456789012/raw/*\",\n                \"arn:aws:s3:::sandbox-pocket-example-dsql-pock-df065f0823-123456789012/imports/*\",\n                \"arn:aws:s3:::sandbox-pocket-example-dsql-pock-df065f0823-123456789012/metadata/*\"\n              ]\n            },\n            {\n              \"Effect\": \"Allow\",\n              \"Action\": [\n                \"s3:PutObject\"\n              ],\n              \"Resource\": [\n                \"arn:aws:s3:::sandbox-pocket-example-dsql-pock-df065f0823-123456789012/metadata/*\"\n              ]\n            }\n          ]\n        },\n        \"sandbox-pocket-example-dsql-pocket-access-ssm\": {\n          \"Version\": \"2012-10-17\",\n          \"Statement\": [\n            {\n              \"Effect\": \"Allow\",\n              \"Action\": [\n                \"ssm:GetParameter\",\n                \"ssm:GetParameters\",\n                \"ssm:GetParametersByPath\"\n              ],\n              \"Resource\": [\n                \"arn:aws:ssm:ap-northeast-1:123456789012:parameter/sandbox-pocket-example-dsql-main-pocket/*\"\n              ]\n            }\n          ]\n        },\n        \"sandbox-pocket-example-dsql-pocket-access-dsql\": {\n          \"Version\": \"2012-10-17\",\n          \"Statement\": [\n            {\n              \"Effect\": \"Allow\",\n              \"Action\": [\n                \"dsql:DbConnectAdmin\"\n              ],\n              \"Resource\": [\n                \"arn:aws:dsql:ap-northeast-1:123456789012:cluster/*\"\n              ],\n              \"Condition\": {\n                \"StringEquals\": {\n                  \"aws:ResourceTag/Name\": \"sandbox-pocket-example-dsql-pocket-dsql\"\n                }\n              }\n            }\n          ]\n        },\n        \"sandbox-pocket-example-dsql-pocket-access-cloudformation\": {\n          \"Version\": \"2012-10-17\",\n          \"Statement\": [\n            {\n              \"Effect\": \"Allow\",\n              \"Action\": [\n                \"cloudformation:DescribeStacks\"\n              ],\n              \"Resource\": [\n                \"arn:aws:cloudformation:ap-northeast-1:123456789012:stack/sandbox-pocket-example-dsql-*\"\n              ]\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"name\": \"sandbox-pocket-example-dsql-myorg-scheduler-role\",\n      \"arn\": \"arn:aws:iam::123456789012:role/sandbox-pocket-example-dsql-myorg-scheduler-role\",\n      \"assume_role_policy\": {\n        \"Version\": \"2012-10-17\",\n        \"Statement\": [\n          {\n            \"Effect\": \"Allow\",\n            \"Principal\": {\n              \"Service\": \"scheduler.amazonaws.com\"\n            },\n            \"Action\": \"sts:AssumeRole\"\n          }\n        ]\n      },\n      \"managed_policy_arns\": [],\n      \"inline_policies\": {\n        \"invoke-handlers\": {\n          \"Version\": \"2012-10-17\",\n          \"Statement\": [\n            {\n              \"Effect\": \"Allow\",\n              \"Action\": [\n                \"sqs:SendMessage\"\n              ],\n              \"Resource\": [\n                \"arn:aws:sqs:ap-northeast-1:123456789012:sandbox-pocket-example-dsql-pocket-main-worker\"\n              ]\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"name\": \"sandbox-pocket-example-dsql-myorg-backup-role\",\n      \"arn\": \"arn:aws:iam::123456789012:role/sandbox-pocket-example-dsql-myorg-backup-role\",\n      \"assume_role_policy\": {\n        \"Version\": \"2012-10-17\",\n        \"Statement\": [\n          {\n            \"Effect\": \"Allow\",\n            \"Principal\": {\n              \"Service\": \"backup.amazonaws.com\"\n            },\n            \"Action\": \"sts:AssumeRole\"\n          }\n        ]\n      },\n      \"managed_policy_arns\": [\n        \"arn:aws:iam::aws:policy/service-role/AWSBackupServiceRolePolicyForBacku