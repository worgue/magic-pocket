  "roles": "{\n  \"stage\": \"mail\",\n  \"region\": \"ap-northeast-1\",\n  \"account_id\": \"123456789012\",\n  \"external_roles\": false,\n  \"roles\": [\n    {\n      \"name\": \"lambda-mail-perm-app-pocket\",\n      \"arn\": \"arn:aws:iam::123456789012:role/lambda-mail-perm-app-pocket\",\n      \"assume_role_policy\": {\n        \"Statement\": [\n          {\n            \"Effect\": \"Allow\",\n            \"Principal\": {\n              \"Service\": \"lambda.amazonaws.com\"\n            },\n            \"Action\": \"sts:AssumeRole\"\n          }\n        ]\n      },\n      \"managed_policy_arns\": [\n        \"arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole\",\n        \"arn:aws:iam::aws:policy/service-role/AWSLambdaVPCAccessExecutionRole\",\n        \"arn:aws:iam::aws:policy/AmazonSQSFullAccess\"\n      ],\n      \"inline_policies\": {\n        \"inbound-support\": {\n          \"Version\": \"2012-10-17\",\n          \"Statement\": [\n            {\n              \"Effect\": \"Allow\",\n              \"Action\": [\n                \"s3:ListBucket\"\n              ],\n              \"Resource\": [\n                \"arn:aws:s3:::mail-perm-pocket-inbound-support-d2efa54d05-123456789012\"\n              ]\n            },\n            {\n              \"Effect\": \"Deny\",\n              \"Action\": [\n                \"s3:DeleteObject\",\n                \"s3:DeleteObjectVersion\"\n              ],\n              \"Resource\": [\n                \"arn:aws:s3:::mail-perm-pocket-inbound-support-d2efa54d05-123456789012/raw/*\",\n                \"arn:aws:s3:::mail-perm-pocket-inbound-support-d2efa54d05-123456789012/metadata/*\"\n              ]\n            },\n            {\n              \"Effect\": \"Allow\",\n              \"Action\": [\n                \"s3:GetObject\",\n                \"s3:GetObjectVersion\"\n              ],\n              \"Resource\": [\n                \"arn:aws:s3:::mail-perm-pocket-inbound-support-d2efa54d05-123456789012/raw/*\",\n                \"arn:aws:s3:::mail-perm-pocket-inbound-support-d2efa54d05-123456789012/imports/*\",\n                \"arn:aws:s3:::mail-perm-pocket-inbound-support-d2efa54d05-123456789012/metadata/*\"\n              ]\n            },\n            {\n              \"Effect\": \"Allow\",\n              \"Action\": [\n                \"s3:PutObject\"\n              ],\n              \"Resource\": [\n                \"arn:aws:s3:::mail-perm-pocket-inbound-support-d2efa54d05-123456789012/metadata/*\"\n              ]\n            }\n          ]\n        },\n        \"mail-perm-pocket-access-cloudformation\": {\n          \"Version\": \"2012-10-17\",\n          \"Statement\": [\n            {\n              \"Effect\": \"Allow\",\n              \"Action\": [\n                \"cloudformation:DescribeStacks\"\n              ],\n              \"Resource\": [\n                \"arn:aws:cloudformation:ap-northeast-1:123456789012:stack/mail-perm-*\"\n              ]\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"name\": \"mail-perm-pocket-codebuild-role\",\n      \"arn\": \"arn:aws:iam::123456789012:role/mail-perm-pocket-codebuild-role\",\n      \"assume_role_policy\": {\n        \"Version\": \"2012-10-17\",\n        \"Statement\": [\n          {\n            \"Effect\": \"Allow\",\n            \"Principal\": {\n              \"Service\": \"codebuild.amazonaws.com\"\n            },\n            \"Action\": \"sts:AssumeRole\"\n          }\n        ]\n      },\n      \"managed_policy_arns\": [],\n      \"inline_policies\": {\n        \"codebuild-policy\": {\n          \"Version\": \"2012-10-17\",\n          \"Statement\": [\n            {\n              \"Effect\": \"Allow\",\n              \"Action\": [\n                \"ecr:GetAuthorizationToken\"\n              ],\n              \"Resource\": \"*\"\n            },\n            {\n              \"Effect\": \"Allow\",\n              \"Action\": [\n                \"ecr:BatchCheckLayerAvailability\",\n                \"ecr:GetDownloadUrlForLayer\",\n                \"ecr:BatchGetImage\",\n                \"ecr:PutImage\",\n                \"ecr:InitiateLayerUpload\",\n                \"ecr:UploadLayerPart\",\n                \"ecr:CompleteLayerUpload\"\n              ],\n              \"Resource\": \"arn:aws:ecr:ap-northeast-1:123456789012:repository/*\"\n            },\n            {\n              \"Effect\": \"Allow\",\n              \"Action\": [\n                \"s3:GetObject\",\n                \"s3:GetObjectVersion\"\n              ],\n              \"Resource\": \"arn:aws:s3:::mail-perm-pocket-state/codebuild/*\"\n            },\n            {\n              \"Effect\": \"Allow\",\n              \"Action\": [\n                \"logs:CreateLogGroup\",\n                \"logs:CreateLogStream\",\n                \"logs:PutLogEvents\"\n              ],\n              \"Resource\": \"arn:aws:logs:ap-northeast-1:123456789012:log-group:/aws/codebuild/mail-perm-pocket-codebuild*\"\n            }\n          ]\n        }\n      }\n    }\n  ]\n}\n",
