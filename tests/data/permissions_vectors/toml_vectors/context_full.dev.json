  "roles": "{\n  \"stage\": \"dev\",\n  \"region\": \"ap-northeast-1\",\n  \"account_id\": \"123456789012\",\n  \"external_roles\": true,\n  \"roles\": [\n    {\n      \"name\": \"dev-ctx-myorg-lambda-role\",\n      \"arn\": \"arn:aws:iam::123456789012:role/dev-ctx-myorg-lambda-role\",\n      \"assume_role_policy\": {\n        \"Version\": \"2012-10-17\",\n        \"Statement\": [\n          {\n            \"Effect\": \"Allow\",\n            \"Principal\": {\n              \"Service\": \"lambda.amazonaws.com\"\n            },\n            \"Action\": \"sts:AssumeRole\"\n          }\n        ]\n      },\n      \"managed_policy_arns\": [\n        \"arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole\",\n        \"arn:aws:iam::aws:policy/service-role/AWSLambdaVPCAccessExecutionRole\",\n        \"arn:aws:iam::aws:policy/AmazonS3FullAccess\",\n        \"arn:aws:iam::aws:policy/AmazonRoute53FullAccess\",\n        \"arn:aws:iam::aws:policy/AmazonSQSFullAccess\",\n        \"arn:aws:iam::aws:policy/AmazonElasticFileSystemFullAccess\"\n      ],\n      \"inline_policies\": {\n        \"inbound-support\": {\n          \"Version\": \"2012-10-17\",\n          \"Statement\": [\n            {\n              \"Effect\": \"Allow\",\n              \"Action\": [\n                \"s3:ListBucket\"\n              ],\n              \"Resource\": [\n                \"arn:aws:s3:::dev-ctx-pocket-inbound-support-41d19ddf04-123456789012\"\n              ]\n            },\n            {\n              \"Effect\": \"Deny\",\n              \"Action\": [\n                \"s3:DeleteObject\",\n                \"s3:DeleteObjectVersion\"\n              ],\n              \"Resource\": [\n                \"arn:aws:s3:::dev-ctx-pocket-inbound-support-41d19ddf04-123456789012/raw/*\",\n                \"arn:aws:s3:::dev-ctx-pocket-inbound-support-41d19ddf04-123456789012/metadata/*\"\n              ]\n            },\n            {\n              \"Effect\": \"Allow\",\n              \"Action\": [\n                \"s3:GetObject\",\n                \"s3:GetObjectVersion\"\n              ],\n              \"Resource\": [\n                \"arn:aws:s3:::dev-ctx-pocket-inbound-support-41d19ddf04-123456789012/raw/*\",\n                \"arn:aws:s3:::dev-ctx-pocket-inbound-support-41d19ddf04-123456789012/imports/*\",\n                \"arn:aws:s3:::dev-ctx-pocket-inbound-support-41d19ddf04-123456789012/metadata/*\"\n              ]\n            },\n            {\n              \"Effect\": \"Allow\",\n              \"Action\": [\n                \"s3:PutObject\"\n              ],\n              \"Resource\": [\n                \"arn:aws:s3:::dev-ctx-pocket-inbound-support-41d19ddf04-123456789012/metadata/*\"\n              ]\n            }\n          ]\n        },\n        \"dev-ctx-pocket-access-secretsmanager\": {\n          \"Version\": \"2012-10-17\",\n          \"Statement\": [\n            {\n              \"Effect\": \"Allow\",\n              \"Action\": [\n                \"secretsmanager:GetSecretValue\"\n              ],\n              \"Resource\": [\n                \"arn:aws:secretsmanager:ap-northeast-1:123456789012:secret:dev-ctx-web-pocket-AbCdEf\",\n                \"arn:aws:secretsmanager:ap-northeast-1:123456789012:secret:plain-name-??????\",\n                \"arn:aws:secretsmanager:ap-northeast-1:123456789012:secret:x\",\n                \"arn:aws:secretsmanager:ap-northeast-1:123456789012:secret:dev/external/api-??????\",\n                \"arn:aws:secretsmanager:ap-northeast-1:123456789012:secret:dev-ctx-pocket-AbCdEf\"\n              ]\n            },\n            {\n              \"Effect\": \"Allow\",\n              \"Action\": [\n                \"secretsmanager:GetSecretValue\"\n              ],\n              \"Resource\": [\n                \"arn:aws:secretsmanager:ap-northeast-1:123456789012:secret:dev-ctx-pocket-AbCdEf\"\n              ]\n            }\n          ]\n        },\n        \"dev-ctx-pocket-access-ssm\": {\n          \"Version\": \"2012-10-17\",\n          \"Statement\": [\n            {\n              \"Effect\": \"Allow\",\n              \"Action\": [\n                \"ssm:GetParameter\",\n                \"ssm:GetParameters\",\n                \"ssm:GetParametersByPath\"\n              ],\n              \"Resource\": [\n                \"arn:aws:ssm:ap-northeast-1:123456789012:parameter/p\",\n                \"arn:aws:ssm:ap-northeast-1:123456789012:parameter/plain/param\",\n                \"arn:aws:ssm:ap-northeast-1:123456789012:parameter/dev-ctx-pocket-user/neon_database_url\"\n              ]\n            }\n          ]\n        },\n        \"dev-ctx-pocket-access-cloudformation\": {\n          \"Version\": \"2012-10-17\",\n          \"Statement\": [\n            {\n              \"Effect\": \"Allow\",\n              \"Action\": [\n                \"cloudformation:DescribeStacks\"\n              ],\n              \"Resource\": [\n                \"arn:aws:cloudformation:ap-northeast-1:123456789012:stack/dev-ctx-*\"\n              ]\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"name\": \"dev-ctx-myorg-scheduler-role\",\n      \"arn\": \"arn:aws:iam::123456789012:role/dev-ctx-myorg-scheduler-role\",\n      \"assume_role_policy\": {\n        \"Version\": \"2012-10-17\",\n        \"Statement\": [\n          {\n            \"Effect\": \"Allow\",\n            \"Principal\": {\n              \"Service\": \"scheduler.amazonaws.com\"\n            },\n            \"Action\": \"sts:AssumeRole\"\n          }\n        ]\n      },\n      \"managed_policy_arns\": [],\n      \"inline_policies\": {\n        \"invoke-handlers\": {\n          \"Version\": \"2012-10-17\",\n          \"Statement\": [\n            {\n              \"Effect\": \"Allow\",\n              \"Action\": [\n                \"sqs:SendMessage\"\n              ],\n              \"Resource\": [\n                \"arn:aws:sqs:ap-northeast-1:123456789012:dev-ctx-pocket-worker-jobs\"\n              ]\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"name\": \"dev-ctx-myorg-codebuild-role\",\n      \"arn\": \"arn:aws:iam::123456789012:role/dev-ctx-myorg-codebuild-role\",\n      \"assume_role_policy\": {\n        \"Version\": \"2012-10-17\",\n        \"Statement\": [\n          {\n            \"Effect\": \"Allow\",\n            \"Principal\": {\n              \"Service\": \"codebuild.amazonaws.com\"\n            },\n            \"Action\": \"sts:AssumeRole\"\n          }\n        ]\n      },\n      \"managed_policy_arns\": [],\n      \"inline_policies\": {\n        \"codebuild-policy\": {\n          \"Version\": \"2012-10-17\",\n          \"Statement\": [\n            {\n              \"Effect\": \"Allow\",\n              \"Action\": [\n                \"ecr:GetAuthorizationToken\"\n              ],\n              \"Resource\": \"*\"\n            },\n            {\n              \"Effect\": \"Allow\",\n              \"Action\": [\n                \"ecr:BatchCheckLayerAvailability\",\n                \"ecr:GetDownloadUrlForLayer\",\n                \"ecr:BatchGetImage\",\n                \"ecr:PutImage\",\n                \"ecr:InitiateLayerUpload\",\n                \"ecr:UploadLayerPart\",\n                \"ecr:CompleteLayerUpload\"\n              ],\n              \"Resource\": \"arn:aws:ecr:ap-northeast-1:123456789012:repository/*\"\n            },\n            {\n              \"Effect\": \"Allow\",\n              \"Action\": [\n                \"s3:GetObject\",\n                \"s3:GetObjectVersion\"\n              ],\n              \"Resource\": \"arn:aws:s3:::dev-ctx-pocket-state/codebuild/*\"\n            },\n            {\n              \"Effect\": \"Allow\",\n              \"Action\": [\n                \"logs:CreateLogGroup\",\n                \"logs:CreateLogStream\",\n                \"logs:PutLogEvents\"\n              ],\n              \"Resource\": \"arn:aws:logs:ap-northeast-1:123456789012:log-group:/aws/codebuild/dev-