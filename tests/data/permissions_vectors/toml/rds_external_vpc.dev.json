  "roles": "{\n  \"stage\": \"dev\",\n  \"region\": \"ap-northeast-1\",\n  \"account_id\": \"123456789012\",\n  \"external_roles\": false,\n  \"roles\": [\n    {\n      \"name\": \"lambda-dev-testprj-main-pocket\",\n      \"arn\": \"arn:aws:iam::123456789012:role/lambda-dev-testprj-main-pocket\",\n      \"assume_role_policy\": {\n        \"Statement\": [\n          {\n            \"Effect\": \"Allow\",\n            \"Principal\": {\n              \"Service\": \"lambda.amazonaws.com\"\n            },\n            \"Action\": \"sts:AssumeRole\"\n          }\n        ]\n      },\n      \"managed_policy_arns\": [\n        \"arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole\",\n        \"arn:aws:iam::aws:policy/service-role/AWSLambdaVPCAccessExecutionRole\"\n      ],\n      \"inline_policies\": {\n        \"dev-testprj-pocket-access-rds-secret\": {\n          \"Version\": \"2012-10-17\",\n          \"Statement\": [\n            {\n              \"Effect\": \"Allow\",\n              \"Action\": [\n                \"secretsmanager:GetSecretValue\"\n              ],\n              \"Resource\": [\n                \"arn:aws:secretsmanager:ap-northeast-1:123456789012:secret:rds!cluster-*\"\n              ],\n              \"Condition\": {\n                \"StringEquals\": {\n                  \"aws:ResourceTag/aws:rds:primaryDBClusterArn\": \"arn:aws:rds:ap-northeast-1:123456789012:cluster:dev-testprj-pocket-aurora\"\n                }\n              }\n            }\n          ]\n        },\n        \"dev-testprj-pocket-access-cloudformation\": {\n          \"Version\": \"2012-10-17\",\n          \"Statement\": [\n            {\n              \"Effect\": \"Allow\",\n              \"Action\": [\n                \"cloudformation:DescribeStacks\"\n              ],\n              \"Resource\": [\n                \"arn:aws:cloudformation:ap-northeast-1:123456789012:stack/dev-testprj-*\"\n              ]\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"name\": \"dev-testprj-pocket-codebuild-role\",\n      \"arn\": \"arn:aws:iam::123456789012:role/dev-testprj-pocket-codebuild-role\",\n      \"assume_role_policy\": {\n        \"Version\": \"2012-10-17\",\n        \"Statement\": [\n          {\n            \"Effect\": \"Allow\",\n            \"Principal\": {\n              \"Service\": \"codebuild.amazonaws.com\"\n            },\n            \"Action\": \"sts:AssumeRole\"\n          }\n        ]\n      },\n      \"managed_policy_arns\": [],\n      \"inline_policies\": {\n        \"codebuild-policy\": {\n          \"Version\": \"2012-10-17\",\n          \"Statement\": [\n            {\n              \"Effect\": \"Allow\",\n              \"Action\": [\n                \"ecr:GetAuthorizationToken\"\n              ],\n              \"Resource\": \"*\"\n            },\n            {\n              \"Effect\": \"Allow\",\n              \"Action\": [\n                \"ecr:BatchCheckLayerAvailability\",\n                \"ecr:GetDownloadUrlForLayer\",\n                \"ecr:BatchGetImage\",\n                \"ecr:PutImage\",\n                \"ecr:InitiateLayerUpload\",\n                \"ecr:UploadLayerPart\",\n                \"ecr:CompleteLayerUpload\"\n              ],\n              \"Resource\": \"arn:aws:ecr:ap-northeast-1:123456789012:repository/*\"\n            },\n            {\n              \"Effect\": \"Allow\",\n              \"Action\": [\n                \"s3:GetObject\",\n                \"s3:GetObjectVersion\"\n              ],\n              \"Resource\": \"arn:aws:s3:::dev-testprj-pocket-state/codebuild/*\"\n            },\n            {\n              \"Effect\": \"Allow\",\n              \"Action\": [\n                \"logs:CreateLogGroup\",\n                \"logs:CreateLogStream\",\n                \"logs:PutLogEvents\"\n              ],\n              \"Resource\": \"arn:aws:logs:ap-northeast-1:123456789012:log-group:/aws/codebuild/dev-testprj-pocket-codebuild*\"\n            }\n          ]\n        }\n      }\n    }\n  ]\n}\n",
